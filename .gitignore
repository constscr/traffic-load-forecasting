# Python cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment variables
.env
.env.*
!.env.example

# Jupyter Notebooks
.ipynb_checkpoints/

# IDEs
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Unit tests and coverage artifacts
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Ruff cache
.ruff_cache/

# mypy / type checking cache
.mypy_cache/
.pyre/
.pytype/

# General cache
.cache/

# Logs
*.log
logs/

# Python packaging/build artifacts
build/
dist/
*.egg-info/
.eggs/

# Data files
data/**/*
!data/**/
!data/**/.gitkeep

# Model artifacts
artifacts/**/*
!artifacts/**/
!artifacts/**/.gitkeep

# Reports generated by experiments
reports/**/*
!reports/**/
!reports/**/.gitkeep

# Serialized objects
*.pkl
*.pickle
*.joblib

# Large tabular files
*.csv
*.parquet
*.xlsx

# Exceptions for tracked placeholder files
!.gitkeep
